# Base URL for dataset fetching (vocabulary.json, courses.json, etc.)
# Default local fallback (served directly from public/data/):
VITE_DATA_BASE_URL=/data

# When hosting on GitHub, switch to your raw GitHub URL or jsDelivr CDN:
# VITE_DATA_BASE_URL=https://raw.githubusercontent.com/<username>/<repo>/main/public/data
# Or via high-speed global CDN (recommended for production):
# VITE_DATA_BASE_URL=https://cdn.jsdelivr.net/gh/<username>/<repo>@main/public/data
